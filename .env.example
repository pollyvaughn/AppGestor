# ============================================================
# CONFIGURACION DE BASE DE DATOS
# ============================================================
# Copiá este archivo como ".env" antes de ejecutar el backend.
#
# IMPORTANTE:
# - Este archivo es solamente una plantilla.
# - NO coloques contraseñas reales aquí.
# - El archivo ".env" está ignorado por Git.
# ============================================================

# Servidor donde está funcionando MySQL
DB_HOST=localhost

# Puerto predeterminado de MySQL
DB_PORT=3306

# Nombre de la base de datos creada por database/schema.sql
DB_NAME=finanzas

# Usuario de MySQL
# En una instalación local de XAMPP normalmente es "root"
DB_USER=root

# Contraseña del usuario de MySQL
# Si tu instalación local de XAMPP no tiene contraseña, dejalo vacío.
DB_PASSWORD=

# tienen q hacer en su terminal
# cp .env.example .env
# y modificar cualquier dato d arriba. la contrase;a vacia nomas